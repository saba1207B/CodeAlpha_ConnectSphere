generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  hosted       Meeting[]            @relation("HostMeetings")
  participated MeetingParticipant[]
  messages     Message[]
  files        SharedFile[]
}

model Meeting {
  id           String               @id @default(uuid())
  title        String
  hostId       String
  host         User                 @relation("HostMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  passCode     String?
  isLocked     Boolean              @default(false)
  isEnded      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants MeetingParticipant[]
  messages     Message[]
  files        SharedFile[]
  whiteboard   Whiteboard?
  invites      MeetingInvite[]
}

model MeetingParticipant {
  id              String    @id @default(uuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String    @default("attendee")
  isMuted         Boolean   @default(false)
  isCameraOff     Boolean   @default(false)
  isScreenSharing Boolean   @default(false)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  @@index([meetingId, userId])
}

model Message {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  timestamp DateTime @default(now())

  @@index([meetingId])
}

model SharedFile {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  createdAt   DateTime @default(now())

  @@index([meetingId])
}

model Whiteboard {
  id        String   @id @default(uuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  stateJson String   @default("[]")
  updatedAt DateTime @updatedAt
}

model MeetingInvite {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  email     String
  code      String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([meetingId, email])
}
